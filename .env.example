# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
EMBED_MODEL=text-embedding-3-small

# Optional: provider swap
# ANTHROPIC_API_KEY=sk-ant-your-key

# LangSmith tracing — enables the "🔗 LangSmith trace" link under every answer.
# BOTH the flag and the API key are required.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key
LANGSMITH_PROJECT=langgraph-testing-mastery
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU accounts

# Jira (for the jira agent)
JIRA_URL=https://YOURNAME.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your-classic-jira-token

# Gmail (for the comms agent)
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json

# Guardrails / limits (read at call time)
JIRA_PROJECT_KEY=TEST
ALLOWED_EMAIL_DOMAINS=gmail.com,example.com
# used when the request says "email me" without an address
DEFAULT_EMAIL_TO=
MAX_LOOPS=2
MAX_STEPS=8

# Keep one MCP session per server open (fast). false = new session per tool call (slow).
MCP_PERSISTENT_SESSIONS=true