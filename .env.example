# =====================================================================
#  langgraph-testing-mastery — configuration
#  1. Copy this file to .env        (Mac: cp .env.example .env
#                                     Windows: copy .env.example .env)
#  2. Fill in the values you need.   NEVER commit .env — it's git-ignored.
#  3. Restart Streamlit after any change (MCP servers connect at startup).
#  Full walkthrough: SETUP.md
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED — the app will not start without this
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------
# OPTIONAL — email "me" (who receives "…email me a summary" requests)
# ---------------------------------------------------------------------
DEFAULT_EMAIL_TO=
# email may ONLY be sent to these domains (guardrail)
ALLOWED_EMAIL_DOMAINS=gmail.com,example.com

# ---------------------------------------------------------------------
# OPTIONAL — Jira (SETUP.md Part 6). Leave as-is to skip: Jira shows 🔴
# ---------------------------------------------------------------------
JIRA_URL=https://YOURNAME.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your-jira-api-token
# the ONLY project tickets may be created/updated in (guardrail)
JIRA_PROJECT_KEY=TEST

# ---------------------------------------------------------------------
# OPTIONAL — Gmail (SETUP.md Part 7). Without the file: Gmail shows 🔴
# ---------------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json

# ---------------------------------------------------------------------
# OPTIONAL — LangSmith tracing (SETUP.md Part 8)
# Set BOTH lines to enable the "🔗 LangSmith trace" link under every answer.
# ---------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-testing-mastery
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU accounts only

# ---------------------------------------------------------------------
# OPTIONAL — Claude as an alternative model (pick it in the sidebar)
# ---------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key

# ---------------------------------------------------------------------
# ADVANCED — defaults are fine
# ---------------------------------------------------------------------
EMBED_MODEL=text-embedding-3-small
MAX_LOOPS=2                  # retries of one step when the reviewer rejects it
MAX_STEPS=8                  # max supervisor decisions per request
MCP_PERSISTENT_SESSIONS=true # false = new MCP session per tool call (slow)
